{
   "compilerOptions": {
      "target": "es2023",
      "module": "esnext",
      "lib": ["ES2023"],
      "types": ["node", "express", "pg", "express-session", "passport", "passport-local"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "paths": {
         "@middlewares/*": ["./src/middlewares/*"],
         "@utils/*": ["./src/utils/*"],
         "@models/*": ["./src/models/*"],
         "@routes/*": ["./src/routes/*"],
         "@controllers/*": ["./src/controllers/*"],
         "@custom-types/*": ["./src/types/*"],
         "@repo/types": ["../shared/types.d.ts"]
      },
      "rootDir": "./src",
      "outDir": "./dist"
   },
   "include": ["src/**/*.ts", "src/routes/authenticate.ts"],
   "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
