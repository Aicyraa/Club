{
   "compilerOptions": {
      "target": "es2023",
      "module": "esnext",
      "lib": ["ES2023"],
      "types": ["node", "express", "pg", "express-session", "passport"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "paths": {
         "@middlewares/*": ["./src/middlewares/*"],
         "@error/*": ["./src/error/*"],
         "@models/*": ["./src/models/*"],
         "@routes/*": ["./src/routes/*"],
         "@controllers/*": ["./src/controllers/*"],
         "@custom-types": ["./src/types.ts"]
      },
      "rootDir": "./src",
   },
   "include": ["src/**/*.ts"],
   "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
